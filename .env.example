# LLM inference выполняется через OpenRouter с локальной машины.
# Ключ не коммитьте: задайте OPENROUTER_API_KEY в окружении или в локальном
# .env, который исключён из Git.
MLA_LLM_PROVIDER=openrouter
MLA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MLA_OPENROUTER_MODEL_NAME=qwen/qwen3.5-9b
# OPENROUTER_API_KEY=replace-with-a-new-key

MLA_MAX_TOKENS=3072
MLA_TEMPERATURE=0.0
MLA_TOP_P=0.95
MLA_TOP_K=20
MLA_PRESENCE_PENALTY=1.5
MLA_ENABLE_THINKING=false
# v1 — базовый; v2/v3 — короткие ответы; v2_cot — явное reasoning.
MLA_PROMPT_VERSION=v1

# response_format — OpenRouter/новый vLLM; guided_json — только старый vLLM;
# none — JSON обеспечивается только промптом и парсером.
MLA_STRUCTURED_MODE=response_format

# Аблация «без reasoning»: thinking выключен во всех вызовах
# MLA_DISABLE_THINKING=true

# Начните с 1 для контроля стоимости и rate limits OpenRouter.
MLA_CONCURRENCY=1
MLA_DATA_ROOT=data
MLA_RESULTS_DIR=results
# true — полностью игнорировать question_images и решать только по тексту.
MLA_TEXT_ONLY=false

# Optional retrieval API settings. Direct FAISS retrieval does not use them.
MLA_RETRIEVAL_BASE_URL=http://127.0.0.1:8770
MLA_RETRIEVAL_TIMEOUT_S=10
MLA_RETRIEVAL_TOP_K=5
MLA_RETRIEVAL_FETCH_K=200
MLA_RETRIEVAL_MMR_ENABLED=false
MLA_RETRIEVAL_MMR_LAMBDA=0.5
# score — исходный rank-порядок; edge — сильные чанки по краям контекста.
MLA_RETRIEVAL_CONTEXT_ORDER=score
MLA_RETRIEVAL_MAX_CONTEXT_CHARS=6000
MLA_RETRIEVAL_MAX_CALLS=2
# E4 router: these subjects use the no-tools path.
MLA_RAG_NO_RETRIEVAL_SUBJECTS=Math

# Optional BGE-M3 semantic candidate arm (see docs/bge_m3_semantic_candidates.md).
# Disabled keeps the existing MiniLM+BM25 hybrid path unchanged. When enabled,
# BM25 remains primary and BGE only contributes a deterministic candidate union
# or a low-lexical-recall fallback. The model identity fields are immutable pins.
MLA_BGE_M3_ENABLED=false
MLA_BGE_M3_MODEL_ID=BAAI/bge-m3
MLA_BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
MLA_BGE_M3_LICENSE=mit
MLA_BGE_M3_TASK_CONTRACT=symmetric_retrieval_text_v1
MLA_BGE_M3_EMBEDDING_DIMENSION=1024
MLA_BGE_M3_CANDIDATE_MODE=union
MLA_BGE_M3_PRIMARY_CANDIDATE_K=32
MLA_BGE_M3_SEMANTIC_CANDIDATE_K=32
MLA_BGE_M3_FALLBACK_MIN_CANDIDATES=5
MLA_BGE_M3_BATCH_SIZE=2
MLA_BGE_M3_MAX_LENGTH=1024
# If MLA_RERANK_TOP_N is set while BGE is enabled, it must be at least
# PRIMARY_CANDIDATE_K + SEMANTIC_CANDIDATE_K (64 for these defaults).
# Fail closed on an absent local snapshot by default; set true only for an
# explicitly authorized pinned download.
MLA_BGE_M3_ALLOW_DOWNLOAD=false
# MLA_BGE_M3_CACHE_DIR=C:\path\to\huggingface-cache
# MLA_BGE_M3_INDEX_DIR=C:\path\to\bge-m3-faiss-index
# MLA_BGE_M3_DEVICE=cpu
# Global FAISS selection; the enabled BGE arm records the requested kind.
MLA_FAISS_INDEX_KIND=auto

# B1 web search / deep search.
MLA_SEARXNG_URL=http://localhost:8080
MLA_SEARCH_K=5
MLA_AGENT_MAX_STEPS=6
MLA_B1_NO_SEARCH_SUBJECTS=Math
MLA_RERANK_URL=http://localhost:8002
MLA_DEEP_SEARCH_PAGES=8
MLA_DEEP_SEARCH_CHUNKS=6

# Трассировка в Langfuse (опционально): pip install -e ".[tracing]"
# MLA_LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000   # self-hosted; cloud: https://cloud.langfuse.com
