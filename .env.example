# Скопировать в .env и поправить под машину.
# Локально: vLLM на GPU-машине можно пробросить по ssh:
#   ssh -N -L 8000:localhost:8000 user@gpu-host
MLA_VLLM_BASE_URL=http://localhost:8000/v1
MLA_VLLM_API_KEY=EMPTY

# HF-идентификатор чекпоинта. Qwen3.5-9B мультимодальна (VL встроен).
# Локальная проверка через Ollama: MLA_VLLM_BASE_URL=http://localhost:11434/v1
#                                  MLA_MODEL_NAME=qwen3.5:9b-q4_K_M
MLA_MODEL_NAME=Qwen/Qwen3.5-9B

MLA_MAX_TOKENS=4096
MLA_TEMPERATURE=0.0
# v1 — базовый; v2_cot — с chain-of-thought (поле reasoning перед решением)
MLA_PROMPT_VERSION=v2_cot

# response_format | guided_json | none  (зависит от версии vLLM)
MLA_STRUCTURED_MODE=response_format

# Аблация «без reasoning»: thinking выключен во всех вызовах
# MLA_DISABLE_THINKING=true

# Ollama на ноутбуке: 1. vLLM на A100: 16-24 (40GB) / 24-32 (80GB) —
# continuous batching, конкурентные запросы почти бесплатны.
MLA_CONCURRENCY=4
MLA_DATA_ROOT=data
MLA_RESULTS_DIR=results

# Трассировка в Langfuse (опционально): pip install -e ".[tracing]"
# MLA_LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000   # self-hosted; cloud: https://cloud.langfuse.com
