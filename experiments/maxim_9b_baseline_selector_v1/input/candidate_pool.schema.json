{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxim-9b-baseline-candidate-pool-row-v1",
  "title": "Gold-blind full274 candidate pool row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "opaque_id", "observable", "anchor", "routers", "parallel_batches"],
  "properties": {
    "schema_version": {"const": "maxim-9b-baseline-candidate-pool-row-v1"},
    "opaque_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "observable": {"$ref": "#/$defs/observable"},
    "anchor": {"$ref": "#/$defs/candidate"},
    "routers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v4", "v5"],
      "properties": {
        "v4": {"$ref": "#/$defs/candidate"},
        "v5": {"$ref": "#/$defs/candidate"}
      }
    },
    "parallel_batches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel8_v1", "parallel8_reasoning_first_v2"],
      "properties": {
        "parallel8_v1": {"$ref": "#/$defs/parallelBatch"},
        "parallel8_reasoning_first_v2": {"$ref": "#/$defs/parallelBatch"}
      }
    }
  },
  "$defs": {
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_type", "option_count", "evaluation_route", "subject", "grade",
        "question_char_count", "ocr_char_count", "image_count", "image_widths", "image_heights"
      ],
      "properties": {
        "answer_type": {"enum": ["choice", "other"]},
        "option_count": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 2, "maximum": 5}]},
        "evaluation_route": {"enum": ["deterministic", "image_judge"]},
        "subject": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]},
        "grade": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]},
        "question_char_count": {"type": "integer", "minimum": 0},
        "ocr_char_count": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "image_count": {"type": "integer", "minimum": 0},
        "image_widths": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "image_heights": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason", "error", "forced_answer", "input_tokens", "output_tokens", "call_count",
        "temperature", "seed", "prompt_version", "upstream_artifact_sha256", "gold_access",
        "score_or_outcome_access", "known_error_memory_access", "source_access"
      ],
      "properties": {
        "finish_reason": {"enum": ["stop", "length", "error", "missing"]},
        "error": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "forced_answer": {"type": "boolean"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "call_count": {"type": "integer", "minimum": 0},
        "temperature": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "seed": {"anyOf": [{"type": "null"}, {"type": "integer"}]},
        "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "upstream_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gold_access": {"const": false},
        "score_or_outcome_access": {"const": false},
        "known_error_memory_access": {"const": false},
        "source_access": {"const": false}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "model", "final_answer", "generation"],
      "properties": {
        "available": {"type": "boolean"},
        "model": {"const": "Qwen/Qwen3.5-9B"},
        "final_answer": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "generation": {"$ref": "#/$defs/generation"}
      }
    },
    "parallelBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final", "raw_votes"],
      "properties": {
        "final": {"$ref": "#/$defs/candidate"},
        "raw_votes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    }
  }
}
