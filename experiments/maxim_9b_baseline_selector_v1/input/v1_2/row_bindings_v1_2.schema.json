{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxim-9b-baseline-selector-combined-row-bindings-v1.2",
  "title": "Six-role row bindings v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_sha256",
    "benchmark_order_sha256",
    "projection_contract",
    "upstream_artifact_sha256",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "maxim-9b-baseline-selector-combined-row-bindings-v1.2"},
    "benchmark_sha256": {"const": "5a6a38ccae7835f0d015f6e5979834208347b8e6e7a8d6884e4af97605f51ed9"},
    "benchmark_order_sha256": {"const": "7140c7c01b48053f6a15a3b0113f68cad37bbb887744828b570a6eaa0447d62b"},
    "projection_contract": {"const": "sha256_of_utf8_json_sort_keys_compact_role_projection"},
    "upstream_artifact_sha256": {"$ref": "#/$defs/role_hashes"},
    "rows": {
      "type": "array",
      "minItems": 274,
      "maxItems": 274,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_index", "task_id", "role_projection_sha256"],
        "properties": {
          "row_index": {"type": "integer", "minimum": 0, "maximum": 273},
          "task_id": {"type": "string", "pattern": "^val_[0-9]{4}$"},
          "role_projection_sha256": {"$ref": "#/$defs/role_hashes"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_crop_v2",
        "native_thinking_math_router_v4",
        "native_thinking_math_router_v5",
        "parallel8_v1",
        "parallel8_reasoning_first_v2",
        "structural_strict_9b"
      ],
      "properties": {
        "active_crop_v2": {"$ref": "#/$defs/sha256"},
        "native_thinking_math_router_v4": {"$ref": "#/$defs/sha256"},
        "native_thinking_math_router_v5": {"$ref": "#/$defs/sha256"},
        "parallel8_v1": {"$ref": "#/$defs/sha256"},
        "parallel8_reasoning_first_v2": {"$ref": "#/$defs/sha256"},
        "structural_strict_9b": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
