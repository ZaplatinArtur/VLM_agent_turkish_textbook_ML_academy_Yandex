{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxim-9b-baseline-selector-pool-row-v1.2",
  "title": "Gold/outcome-blind six-role selector pool row v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_index",
    "anchor",
    "routers",
    "parallel_batches",
    "structural"
  ],
  "properties": {
    "schema_version": {
      "const": "maxim-9b-baseline-selector-pool-row-v1.2"
    },
    "row_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 273
    },
    "anchor": {
      "$ref": "#/$defs/source_blind_candidate"
    },
    "routers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v4", "v5"],
      "properties": {
        "v4": {"$ref": "#/$defs/source_blind_candidate"},
        "v5": {"$ref": "#/$defs/source_blind_candidate"}
      }
    },
    "parallel_batches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel8_v1", "parallel8_reasoning_first_v2"],
      "properties": {
        "parallel8_v1": {"$ref": "#/$defs/parallel_batch"},
        "parallel8_reasoning_first_v2": {"$ref": "#/$defs/parallel_batch"}
      }
    },
    "structural": {
      "$ref": "#/$defs/structural_candidate"
    }
  },
  "$defs": {
    "generation_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason",
        "error",
        "forced_answer",
        "input_tokens",
        "output_tokens",
        "call_count",
        "temperature",
        "seed",
        "prompt_version",
        "upstream_artifact_sha256",
        "new_arm_gold_reference_correctness_outcome_or_judge_access",
        "source_access"
      ],
      "properties": {
        "finish_reason": {
          "enum": ["stop", "length", "error", "missing"]
        },
        "error": {
          "type": ["string", "null"]
        },
        "forced_answer": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "call_count": {
          "type": "integer",
          "minimum": 0
        },
        "temperature": {
          "type": ["number", "null"]
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "prompt_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "upstream_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "new_arm_gold_reference_correctness_outcome_or_judge_access": {
          "const": false
        },
        "source_access": {
          "type": "boolean"
        }
      }
    },
    "candidate_common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "model", "final_answer", "generation"],
      "properties": {
        "available": {"type": "boolean"},
        "model": {"const": "Qwen/Qwen3.5-9B"},
        "final_answer": {"type": ["string", "null"]},
        "generation": {"$ref": "#/$defs/generation_common"}
      }
    },
    "source_blind_candidate": {
      "allOf": [
        {"$ref": "#/$defs/candidate_common"},
        {
          "properties": {
            "generation": {
              "allOf": [
                {"$ref": "#/$defs/generation_common"},
                {"properties": {"source_access": {"const": false}}}
              ]
            }
          }
        }
      ]
    },
    "structural_candidate": {
      "allOf": [
        {"$ref": "#/$defs/candidate_common"},
        {
          "properties": {
            "generation": {
              "allOf": [
                {"$ref": "#/$defs/generation_common"},
                {
                  "properties": {
                    "upstream_artifact_sha256": {
                      "const": "4c73b6eb326e5790b19e14c01a79df853be23bb5f55b498ce4c58b78ebc3dff5"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "parallel_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final", "raw_votes"],
      "properties": {
        "final": {"$ref": "#/$defs/source_blind_candidate"},
        "raw_votes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/source_blind_candidate"}
        }
      }
    }
  }
}
