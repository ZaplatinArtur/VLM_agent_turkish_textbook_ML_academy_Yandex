{
  "schema_version": "maxim-turhistquad-embedder-preregistration-v1",
  "created_at": "2026-08-09",
  "purpose": "Outcome-independent Turkish retrieval comparison of the current project embedder and multilingual alternatives.",
  "dataset": {
    "id": "mteb/TurHistQuadRetrieval",
    "revision": "b6e74379b7486da28ce81c3d459cd7bbd87d4987",
    "license": "mit",
    "split": "test",
    "subsets": [
      "corpus",
      "queries",
      "qrels"
    ],
    "expected_corpus_rows": 1213,
    "official_source": "https://huggingface.co/datasets/mteb/TurHistQuadRetrieval",
    "relationship_to_project_benchmark": "none"
  },
  "guards": {
    "project_benchmark_queries_access": false,
    "project_benchmark_references_access": false,
    "project_benchmark_correctness_access": false,
    "project_judge_access": false,
    "training_or_threshold_tuning_on_test": false,
    "external_test_used_for_model_selection": true,
    "all_models_cpu_local": true,
    "shared_gpu": false
  },
  "retrieval_protocol": {
    "corpus_text": "title + newline + text, omitting an empty title",
    "query_text": "dataset query text",
    "similarity": "dot product of L2-normalized dense vectors (cosine)",
    "tie_break": "ascending corpus _id for exactly equal scores",
    "relevance": "all qrels rows with score > 0",
    "metrics": [
      "Recall@1",
      "Recall@5",
      "MRR"
    ],
    "latency": [
      "model_load_seconds",
      "corpus_encode_seconds",
      "query_encode_seconds",
      "search_seconds",
      "wall_seconds"
    ],
    "metric_definition": "Recall@k is query hit-rate: 1 when any relevant corpus id is present in top-k, otherwise 0; MRR uses the first relevant rank.",
    "bootstrap": {
      "enabled": true,
      "samples": 10000,
      "seed": 20260809,
      "paired_by_query": true,
      "confidence_level": 0.95
    },
    "no_hyperparameter_search": true
  },
  "conditions": [
    {
      "name": "current_minilm",
      "model_id": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
      "revision": "e8f8c211226b894fcb81acc59f3b34ba3efd5f42",
      "license": "apache-2.0",
      "adapter": "sentence_transformers_mean_pooling",
      "query_instruction": null,
      "max_length": 128,
      "batch_size_cpu": 32,
      "embedding_dimension": 384
    },
    {
      "name": "bge_m3_dense",
      "model_id": "BAAI/bge-m3",
      "revision": "5617a9f61b028005a4858fdac845db406aefb181",
      "license": "mit",
      "adapter": "official_cls_dense",
      "query_instruction": null,
      "max_length": 1024,
      "batch_size_cpu": 2,
      "embedding_dimension": 1024
    },
    {
      "name": "gte_multilingual_base",
      "model_id": "Alibaba-NLP/gte-multilingual-base",
      "revision": "9bbca17d9273fd0d03d5725c7a4b0f6b45142062",
      "license": "apache-2.0",
      "adapter": "official_cls_dense_remote_code",
      "remote_code_repo": "Alibaba-NLP/new-impl",
      "remote_code_revision": "40ced75c3017eb27626c9d4ea981bde21a2662f4",
      "query_instruction": null,
      "max_length": 1024,
      "batch_size_cpu": 2,
      "embedding_dimension": 768
    },
    {
      "name": "qwen3_embedding_0_6b_optional",
      "optional": true,
      "run_only_if_cpu_smoke_is_reasonable": true,
      "model_id": "Qwen/Qwen3-Embedding-0.6B",
      "revision": "97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3",
      "license": "apache-2.0",
      "adapter": "official_last_token_pooling",
      "query_instruction": "Given a Turkish question, retrieve passages that answer the question.",
      "max_length": 1024,
      "batch_size_cpu": 1,
      "embedding_dimension": 1024
    }
  ],
  "reporting": {
    "report_all_preregistered_non_optional_conditions": true,
    "report_failures_and_partial_runs": true,
    "do_not_claim_project_score_improvement_from_external_result": true,
    "interpretation": "This test estimates Turkish semantic retrieval transfer only; it does not estimate end-to-end VLM benchmark accuracy."
  }
}
